{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Composer update policy",
  "packageRules": [
    {
      "description": "Keep Composer minor and patch updates together and create rollback PRs",
      "matchManagers": ["composer"],
      "separateMinorPatch": false,
      "rollbackPrs": true
    },
    {
      "description": "Automerge Composer minor and patch updates",
      "matchManagers": ["composer"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Ignore common Composer virtual implementation packages",
      "matchManagers": ["composer"],
      "matchDatasources": ["packagist"],
      "matchPackageNames": ["/-implementation$/"],
      "enabled": false
    },
    {
      "description": "Group app Composer minor and patch updates",
      "matchManagers": ["composer"],
      "matchFileNames": ["composer.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "App Composer non-major dependencies",
      "groupSlug": "app-composer-non-major",
      "dependencyDashboardCategory": "📦 Composer"
    },
    {
      "description": "Group PHP tool Composer minor and patch updates",
      "matchManagers": ["composer"],
      "matchFileNames": ["tools/.phpstan/composer.json", "tools/.rector/composer.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "PHP tool Composer non-major dependencies",
      "groupSlug": "php-tools-composer-non-major",
      "dependencyDashboardCategory": "🛠️ PHP tools"
    }
  ]
}
