{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "GitHub Actions update policy",
  "extends": [
    "helpers:githubDigestChangelogs",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "packageRules": [
    {
      "description": "Replace workflow runtime and tool versions",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Create initial GitHub Actions digest pinning PRs without release-age delay",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pinDigest"],
      "groupName": "GitHub Actions digest pinning",
      "groupSlug": "github-actions-digest-pinning",
      "minimumReleaseAge": null,
      "automerge": true,
      "dependencyDashboardCategory": "⚙️ GitHub Actions"
    },
    {
      "description": "Group and automerge GitHub Action and reusable workflow minor and patch updates",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions non-major dependencies",
      "groupSlug": "github-actions-non-major",
      "automerge": true,
      "dependencyDashboardCategory": "⚙️ GitHub Actions"
    },
    {
      "description": "Group and automerge workflow runtime and tool minor and patch updates",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Workflow runtime and tool non-major dependencies",
      "groupSlug": "workflow-runtime-tool-non-major",
      "automerge": true,
      "dependencyDashboardCategory": "⚙️ Workflow runtimes and tools"
    }
  ]
}
