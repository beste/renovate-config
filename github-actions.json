{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "GitHub Actions defaults for beste/ repos",
  "packageRules": [
    {
      "description": "Create initial GitHub Actions digest pinning PRs without release-age delay",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pinDigest"],
      "minimumReleaseAge": null,
      "automerge": true
    },
    {
      "description": "Group and automerge GitHub Actions minor and patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions non-major dependencies",
      "groupSlug": "github-actions-non-major",
      "automerge": true,
      "dependencyDashboardCategory": "⚙️ GitHub Actions"
    }
  ]
}
