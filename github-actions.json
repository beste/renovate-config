{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "GitHub Actions update policy",
  "extends": [
    "helpers:githubDigestChangelogs",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update actionlint invoked through Go in GitHub Actions workflows",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "go[ \\t]+(?:run|install)[ \\t]+github\\.com/rhysd/actionlint/cmd/actionlint@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "github.com/rhysd/actionlint",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver",
      "depTypeTemplate": "uses-with"
    },
    {
      "customType": "regex",
      "description": "Update crates installed by Cargo in GitHub Actions workflows",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "cargo[ \\t]+install[ \\t]+(?<depName>[A-Za-z0-9][A-Za-z0-9_-]*)@(?<currentValue>\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?)",
        "cargo[ \\t]+install[ \\t]+(?<depName>[A-Za-z0-9][A-Za-z0-9_-]*)[ \\t]+--(?:vers|version)[ \\t]+(?<currentValue>\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?)"
      ],
      "datasourceTemplate": "crate",
      "versioningTemplate": "cargo",
      "depTypeTemplate": "uses-with"
    }
  ],
  "packageRules": [
    {
      "description": "Replace workflow runtime and tool versions",
      "matchManagers": ["github-actions", "custom.regex"],
      "matchDepTypes": ["uses-with"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Create initial GitHub Actions digest pinning PRs without release-age delay",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pinDigest"],
      "groupName": "GitHub Actions digest pinning",
      "groupSlug": "github-actions-digest-pinning",
      "minimumReleaseAge": null,
      "automerge": true,
      "dependencyDashboardCategory": "⚙️ GitHub Actions"
    },
    {
      "description": "Group and automerge GitHub Action and reusable workflow minor and patch updates",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions non-major dependencies",
      "groupSlug": "github-actions-non-major",
      "automerge": true,
      "dependencyDashboardCategory": "⚙️ GitHub Actions"
    },
    {
      "description": "Group and automerge workflow runtime and tool minor and patch updates",
      "matchManagers": ["github-actions", "custom.regex"],
      "matchDepTypes": ["uses-with"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Workflow runtime and tool non-major dependencies",
      "groupSlug": "workflow-runtime-tool-non-major",
      "automerge": true,
      "dependencyDashboardCategory": "⚙️ Workflow runtimes and tools"
    }
  ]
}
