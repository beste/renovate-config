{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Complete PHP preset",
  "extends": [
    "./default",
    "./php-composer",
    "./php-platform"
  ],
  "packageRules": [
    {
      "description": "Disable routine updates for repo-local tools while keeping vulnerability alerts active",
      "matchFileNames": ["tools/**"],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance",
        "rollback",
        "replacement"
      ],
      "enabled": false
    }
  ]
}
