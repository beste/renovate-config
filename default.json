{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default configuration for repositories under `beste/`",
  "extends": [
    ":automergeBranch",
    ":automergeMinor",
    ":configMigration",
    ":dependencyDashboard",
    ":enableVulnerabilityAlerts",
    ":ignoreModulesAndTests",
    ":label(dependencies)",
    ":rebaseStalePrs",
    ":semanticCommitsDisabled",
    ":separateMajorReleases",
    ":timezone(UTC)",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "local>beste/renovate-config:github-actions"
  ],
  "commitBodyTable": true,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "schedule": ["* 6 * * *"],
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "lockFileMaintenance": {
    "enabled": true,
    "extends": ["schedule:daily"]
  },
  "packageRules": [
    {
      "description": "Shorter wait for patch updates",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Automerge docs Python tooling minor and patch updates",
      "matchFileNames": ["docs/pyproject.toml", "docs/uv.lock"],
      "matchManagers": ["pep621", "uv"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "dependencyDashboardCategory": "📚 Docs"
    }
  ],
  "major": {
    "dependencyDashboardApproval": true
  },
  "osvVulnerabilityAlerts": true,
  "rangeStrategy": "widen",
  "vulnerabilityAlerts": {
    "extends": [":automergeDisabled", ":automergePr", ":labels(security)"],
    "rangeStrategy": "bump"
  }
}
