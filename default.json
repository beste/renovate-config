{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default configuration for repositories under `beste/`",
  "extends": [
    ":automergeBranch",
    ":automergeMinor",
    ":configMigration",
    ":dependencyDashboard",
    ":enableVulnerabilityAlerts",
    ":ignoreModulesAndTests",
    ":label(dependencies)",
    ":rebaseStalePrs",
    ":semanticCommitsDisabled",
    ":separateMajorReleases",
    ":timezone(UTC)",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "prCreation": "status-success",
  "commitBodyTable": true,
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "schedule": ["0 6 * * *"],
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "lockFileMaintenance": {
    "enabled": true,
    "extends": ["schedule:daily"]
  },
  "packageRules": [
    {
      "description": "Group app Composer minor and patch updates",
      "matchManagers": ["composer"],
      "matchFileNames": ["composer.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "App Composer non-major dependencies",
      "groupSlug": "app-composer-non-major",
      "dependencyDashboardCategory": "📦 Composer"
    },
    {
      "description": "Shorter wait for patch updates",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Group PHP tool Composer minor and patch updates",
      "matchManagers": ["composer"],
      "matchFileNames": ["tools/.phpstan/composer.json", "tools/.rector/composer.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "PHP tool Composer non-major dependencies",
      "groupSlug": "php-tools-composer-non-major",
      "dependencyDashboardCategory": "🛠️ PHP tools"
    },
    {
      "description": "Group GitHub Actions minor and patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions non-major dependencies",
      "groupSlug": "github-actions-non-major",
      "dependencyDashboardCategory": "⚙️ GitHub Actions"
    },
    {
      "description": "Automerge docs Python tooling minor and patch updates",
      "matchFileNames": ["docs/pyproject.toml", "docs/uv.lock"],
      "matchManagers": ["pep621", "uv"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "dependencyDashboardCategory": "📚 Docs"
    }
  ],
  "major": {
    "dependencyDashboardApproval": true
  },
  "osvVulnerabilityAlerts": true,
  "rangeStrategy": "widen",
  "vulnerabilityAlerts": {
    "extends": [":automergeDisabled", ":automergePr", ":labels(security)"],
    "rangeStrategy": "bump"
  }
}
