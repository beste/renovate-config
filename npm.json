{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "npm update policy",
  "packageRules": [
    {
      "description": "Group and automerge npm minor and patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major dependencies",
      "groupSlug": "npm-non-major",
      "automerge": true,
      "dependencyDashboardCategory": "📦 npm"
    },
    {
      "description": "Require manual merge for pre-1.0 npm minor updates",
      "matchManagers": ["npm"],
      "matchCurrentVersion": "/^[~^>=<\\s]*v?0\\./",
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "automerge": false
    }
  ]
}
